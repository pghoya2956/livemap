{
  "engine": 1,
  "adapters": [
    "router",
    "bff",
    "migrations",
    "tests",
    "wiki",
    "tasks",
    "roadmap",
    "git",
    "deploy",
    "testreport"
  ],
  "project": {
    "name": "Mini",
    "host": "https://mini.local"
  },
  "router": {
    "app": "web/src/App.tsx",
    "pagesDir": "web/src/pages",
    "localDirs": [
      "web/src/pages",
      "web/src/components"
    ],
    "mockPattern": "/mock'",
    "livePattern": "lib/queries",
    "hookApi": {
      "Session": "/api/session",
      "Resorts": "/api/resorts",
      "Catalog": "/api/catalog",
      "Teams": "/api/teams",
      "Quote": "/api/quotes/:id",
      "Login": "/api/login",
      "Logout": "/api/logout"
    },
    "fixedPattern": "/content/"
  },
  "bff": {
    "server": "app/server.mjs",
    "dynamicRoutes": [
      {
        "match": "quotes\\/([^/]+)",
        "routes": [
          [
            "GET",
            "/api/quotes/:id",
            [
              "get_quote"
            ]
          ],
          [
            "POST",
            "/api/quotes/:id/validate",
            [
              "validate_quote"
            ]
          ]
        ]
      }
    ]
  },
  "migrations": {
    "dir": "supabase/migrations"
  },
  "tests": {
    "dir": "tests",
    "gatePattern": "MINI_ALLOW_(FRESH|RESTART)",
    "report": "map/.out/junit.xml"
  },
  "tasks": {
    "dir": "tasks",
    "index": "tasks/index.md"
  },
  "wiki": {
    "index": ".agent/wiki/index.md",
    "sources": ".agent/wiki/sources.yaml"
  },
  "git": {
    "branch": "main",
    "sinceDays": 14,
    "areas": [
      [
        "web/",
        "화면"
      ],
      [
        "app/",
        "BFF"
      ],
      [
        "supabase/",
        "DB·런타임"
      ],
      [
        "local/",
        "DB·런타임"
      ],
      [
        "tests/",
        "검사"
      ],
      [
        "deploy/",
        "배포"
      ],
      [
        "Dockerfile",
        "배포"
      ],
      [
        ".github/",
        "배포"
      ],
      [
        "map/",
        "상황판"
      ],
      [
        ".agent/",
        "위키"
      ],
      [
        "tasks/",
        "문서"
      ],
      [
        "docs/",
        "문서"
      ],
      [
        ".md",
        "문서"
      ]
    ],
    "runtimePaths": [
      "web",
      "app",
      "supabase",
      "Dockerfile",
      "package.json"
    ]
  },
  "deploy": {
    "manifest": "deploy/k8s/bff.yaml",
    "imagePattern": "image: ghcr\\.io/[^:]+:([0-9a-f]{40})"
  },
  "semantic": "map/semantic/journeys.json",
  "captures": {
    "site": "map/captures"
  },
  "floors": {
    "screen": 2,
    "api": 2,
    "function": 1,
    "test": 1,
    "task": 1,
    "decision": 1
  },
  "budget": {
    "viewport": [
      1440,
      900
    ],
    "maxPanels": 8,
    "maxRowsPerPanel": 6,
    "navItems": 5
  },
  "roadmap": {
    "file": "tasks/roadmap.md"
  }
}
