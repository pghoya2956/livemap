{
  "version": 1,
  "note": "SC-14 클릭 대상 표(스펙 「클릭 대상」)의 기계용 사본. scripts/route-crawl.mjs가 읽는다. optional 행은 자료·목록 맞춤에 따라 없을 수 있고, when은 건너뛸 조건이다. 특정 프로젝트 문자열을 넣지 않는다. screens.<화면>은 개요 밖 화면의 표다. 크롤러가 hash를 열어 그 화면의 대화형 요소를 이 행들과 대조하고 행마다 판정한다(1.3.0, 로드맵).",
  "routes": [
    { "pattern": "#/overview", "screen": "overview", "check": "빈 해시와 같음, .panel 8개 이하" },
    { "pattern": "#/journeys", "screen": "journeys", "check": "기능 카드 수 = data.semantic.journeys 수" },
    { "pattern": "#/journeys/<journey>", "screen": "journeys", "params": { "journey": "semantic.journeys[].id" }, "check": ".scene 수 = 그 기능 단계 수" },
    { "pattern": "#/journeys/<journey>/<step>", "screen": "journeys", "params": { "journey": "semantic.journeys[].id", "step": "semantic.journeys[].steps[].id" }, "check": ".scene.on 1개, .detail 보임" },
    { "pattern": "#/architecture", "screen": "architecture", "optional": true, "when": "architecture >= 1", "check": "초점 sys · 나눔 「사람이 그린 것」. 부품 상자 수 = architecture.containers 수, 층 상자 수 = 보이는 층 수" },
    { "pattern": "#/architecture/part%3A<part>", "screen": "architecture", "optional": true, "when": "containers >= 1", "params": { "part": "architecture.containers[].id (encodeURIComponent)" }, "check": "빵부스러기 마지막 칸이 그 부품, 층 배치에 그 부품의 노드 상자" },
    { "pattern": "#/architecture/community%3A<community>", "screen": "architecture", "optional": true, "when": "communities >= 1", "params": { "community": "architecture.communities[].id" }, "check": "영향 패널이 그 묶음, 나눔 「코드가 보이는 것」이면 닿는 선이 진해진다" },
    { "pattern": "#/architecture/group%3A<lane>", "screen": "architecture", "optional": true, "when": "architecture >= 1", "params": { "lane": "architecture.lanes[].id (encodeURIComponent)" }, "check": "층 배치에 그 층의 노드 상자" },
    { "pattern": "#/architecture/<node>", "screen": "architecture", "optional": true, "when": "modules >= 1", "params": { "node": "architecture.modules[].id (encodeURIComponent)" }, "check": "영향 패널이 그 노드, 층 배치에 1홉 이웃 점선 상자" },
    { "pattern": "#/architecture/sys/<flow>", "screen": "architecture", "optional": true, "when": "flows >= 1", "params": { "flow": "architecture.flows[].id (encodeURIComponent)" }, "check": "길 패널에 이야기 한 줄, 층 배치에 그 기능의 길" },
    { "pattern": "#/architecture?split=code", "screen": "architecture", "optional": true, "when": "communities >= 1", "check": "묶음 개요, 상자 수 = 보이는 묶음 수" },
    { "pattern": "#/architecture?level=fn", "screen": "architecture", "optional": true, "when": "architecture >= 1", "check": "함수 수준. architecture.json 이 없으면 「함수 수준 자료 없음」과 파일 수준 유지" },
    { "pattern": "#/roadmap", "screen": "roadmap", "check": "항목 카드 수 = data.roadmap 수" },
    { "pattern": "#/roadmap/<item>", "screen": "roadmap", "params": { "item": "roadmap[].id" }, "check": "#rm-<id> 강조·뷰포트 안" },
    { "pattern": "#/roadmap/<milestone>", "optional": true, "when": "milestones >= 1", "screen": "roadmap", "params": { "milestone": "milestones[].id" }, "check": "그 마일스톤 details[open]" },
    { "pattern": "#/tasks", "screen": "tasks", "check": "표 행 1개 이상(작업이 있을 때), 결정 열 없음, 읽기 상태가 부분·낡음·모름인 칸은 ?와 이유 분류" },
    { "pattern": "#/tasks/<task>", "screen": "tasks", "params": { "task": "tasks[].name" }, "check": ".detail 보임, 강조 행, 읽기 상태 이유 문장·근거 줄·판정 글자" },
    { "pattern": "#/changes", "screen": "more", "check": "#/more/changes와 같은 탭 선택" },
    { "pattern": "#/more", "screen": "more", "check": "기본 탭 decisions 선택" },
    { "pattern": "#/more/changes", "screen": "more", "check": "탭 선택, 커밋 목록" },
    { "pattern": "#/more/decisions", "screen": "more", "check": "탭 선택" },
    { "pattern": "#/more/screens", "screen": "more", "check": "탭 선택" },
    { "pattern": "#/more/screens/<screen>", "screen": "more", "params": { "screen": "screens[].path (encodeURIComponent)" }, "check": ".detail 보임, 강조 행" },
    { "pattern": "#/more/backend", "screen": "more", "check": "탭 선택" },
    { "pattern": "#/more/tests", "screen": "more", "check": "탭 선택" },
    { "pattern": "#/more/about", "screen": "more", "check": "탭 선택, 읽기 상태 요약·?인 작업 이유(#/tasks/<task> 링크)·판정 수·이슈 코드 묶음" },
    { "pattern": "#/no-such-route", "screen": "overview", "check": "개요로 렌더, 내비 선택 없음, 콘솔 오류 0" }
  ],
  "overview": [
    { "name": "상단 바 내비", "selector": ".nav a", "kind": "route", "expect": { "hrefs": ["#/overview", "#/journeys", "#/architecture", "#/roadmap", "#/tasks", "#/more"], "ariaCurrent": "#/overview" }, "source": "spec" },
    { "name": "호스트 알약", "selector": "a.pill[target=_blank]", "kind": "external", "expect": { "hostFrom": "project.host", "rel": "noopener noreferrer" }, "source": "spec", "optional": true },
    { "name": "전광판 정지·재생", "selector": ".ticker .pause", "kind": "inplace", "expect": { "ariaPressedToggles": true, "stopsAnimation": ".ticker" }, "source": "spec" },
    { "name": "패널 머리 외 n", "selector": ".ph a.more", "kind": "route", "expect": { "hrefIn": ["#/roadmap", "#/more/changes", "#/journeys"] }, "source": "spec", "optional": true },
    { "name": "완료 마일스톤 접은 행", "selector": "a.row.fold[href^='#/roadmap/']", "kind": "route", "expect": { "pattern": "#/roadmap/<milestone>" }, "source": "spec", "optional": true, "when": "milestones >= 1" },
    { "name": "완료 항목 접은 행", "selector": "a.row.fold[href='#/roadmap']", "kind": "route", "expect": { "pattern": "#/roadmap" }, "source": "spec", "optional": true, "when": "milestones == 0" },
    { "name": "마일스톤 패널 항목·뒤 마일스톤 행", "selector": ".ms a.row:not(.fold)", "kind": "route", "expect": { "patternIn": ["#/roadmap/<item>", "#/roadmap/<milestone>"] }, "source": "proposal" },
    { "name": "로드맵 없음 진행 중인 작업", "selector": "a.tasks-link", "kind": "route", "expect": { "pattern": "#/tasks" }, "source": "proposal", "optional": true },
    { "name": "최근 변경 종류 칩", "selector": ".changes button.chip", "kind": "inplace", "expect": { "ariaPressed": true, "filtersRowsByKind": true }, "source": "spec", "optional": true, "when": "changes >= 1" },
    { "name": "최근 변경 커밋 행", "selector": ".changes a.row", "kind": "route", "expect": { "pattern": "#/more/changes" }, "source": "proposal", "optional": true, "when": "changes >= 1" },
    { "name": "기능 지도 기능 묶음", "selector": "g.jrow", "kind": "inplace", "expect": { "syncsSelection": [".mk.row", ".wt.row"], "keys": ["Enter", " "] }, "source": "spec" },
    { "name": "기능 지도 단계 표식", "selector": "g.jrow circle", "kind": "none", "expect": { "cursor": "default-or-inherit", "title": true }, "source": "spec" },
    { "name": "기능 지도 레이어 버튼", "selector": "button.lyr", "kind": "inplace", "expect": { "ariaPressedToggles": true, "hidesLayer": true }, "source": "spec" },
    { "name": "기능 지도 빈 곳 더블클릭", "selector": ".mapwrap", "kind": "inplace", "expect": { "dblclickClearsFocus": true, "escapeKey": true }, "source": "proposal", "event": "dblclick" },
    { "name": "기능 지도 바닥 칩", "selector": "a.mapfold", "kind": "route", "expect": { "pattern": "#/journeys" }, "source": "spec", "optional": true, "when": "journeys >= 13" },
    { "name": "기능 지도 다음 안내", "selector": "a.mapnote", "kind": "route", "expect": { "pattern": "#/roadmap/<item>" }, "source": "spec", "optional": true },
    { "name": "기능별 변경 행", "selector": "button.mk.row", "kind": "inplace", "expect": { "syncsSelection": ["g.jrow", ".wt.row"] }, "source": "spec" },
    { "name": "특보 결정 대기 행", "selector": ".signals a.row.wait", "kind": "route", "expect": { "patternIn": ["#/roadmap/<item>", "#/roadmap/<milestone>"] }, "source": "proposal", "optional": true },
    { "name": "특보 신호 행", "selector": ".signals a.row.sig", "kind": "route", "expect": { "hrefIn": ["#/more/tests", "#/more/about"] }, "source": "proposal", "optional": true },
    { "name": "화면 썸네일", "selector": ".capture .thumbs button", "kind": "inplace", "expect": { "switchesCapture": true, "stopsRotation": true }, "source": "spec", "optional": true },
    { "name": "화면 캡처 겹침 단계 이름", "selector": ".live .ov a", "kind": "route", "expect": { "pattern": "#/journeys/<journey>/<step>" }, "source": "proposal", "optional": true },
    { "name": "기능 현황 행", "selector": "button.wt.row", "kind": "inplace", "expect": { "switchesDetail": true }, "source": "spec" },
    { "name": "기능 현황 접은 행", "selector": "a.wt.fold.row", "kind": "route", "expect": { "pattern": "#/journeys" }, "source": "spec", "optional": true },
    { "name": "기능 현황 기능 화면", "selector": "a.open", "kind": "route", "expect": { "pattern": "#/journeys/<journey>", "visible": ".scene" }, "source": "spec" }
  ],
  "screens": {
    "architecture": {
      "hash": "#/architecture",
      "when": "architecture >= 1",
      "targets": [
        { "name": "구조 상단 바 내비", "selector": ".nav a", "kind": "route", "expect": { "hrefs": ["#/overview", "#/journeys", "#/architecture", "#/roadmap", "#/tasks", "#/more"], "ariaCurrent": "#/architecture" }, "source": "spec" },
        { "name": "구조 호스트 알약", "selector": "a.pill[target=_blank]", "kind": "external", "expect": { "hostFrom": "project.host", "rel": "noopener noreferrer" }, "source": "spec", "optional": true },
        { "name": "시스템 그림 부품 상자", "selector": ".am-sys .am-part", "kind": "inplace", "expect": { "setsFocus": "part:<container>", "hashPattern": "#/architecture/part%3A<part>", "keys": ["Enter", " "], "scrollYUnchanged": true }, "source": "spec" },
        { "name": "묶음 개요 묶음 상자", "hash": "#/architecture?split=code", "selector": ".am-comm .am-cbox", "kind": "inplace", "expect": { "setsFocus": "community:<id>", "hashPattern": "#/architecture/community%3A<community>", "keys": ["Enter", " "], "highlightsTouchingEdges": ".am-comm .am-edge.on", "scrollYUnchanged": true }, "source": "spec", "optional": true, "when": "communities >= 1" },
        { "name": "층 요약 「열기」", "selector": ".am-lanes button.am-openbtn", "kind": "inplace", "expect": { "setsFocus": "group:<lane>", "hashPattern": "#/architecture/group%3A<lane>" }, "source": "spec" },
        { "name": "층 배치 노드 상자", "hash": "#/architecture/group%3A<lane>", "selector": ".am-nodes .am-nbox", "kind": "inplace", "expect": { "setsFocus": "<node>", "hashPattern": "#/architecture/<node>", "keys": ["Enter", " "] }, "source": "spec" },
        { "name": "층 배치 묶은 선", "hash": "#/architecture/part%3A<part>", "selector": ".am-node-edge.is-bundle", "kind": "inplace", "expect": { "focusUnchanged": true, "ariaLabel": true }, "source": "spec", "optional": true },
        { "name": "빵부스러기", "hash": "#/architecture/group%3A<lane>", "selector": ".am-crumbs button.am-link", "kind": "inplace", "expect": { "movesFocusUp": true }, "source": "spec", "optional": true },
        { "name": "수준 토글", "hash": "#/architecture/part%3A<part>", "selector": ".am-toggles [aria-label=수준] button.chip", "kind": "inplace", "expect": { "ariaPressed": true, "queryParam": "level", "chipText": "함수 노드 N · 선 M" }, "source": "spec" },
        { "name": "나눔 토글", "selector": ".am-toggles [aria-label=나눔] button.chip", "kind": "inplace", "expect": { "ariaPressed": true, "queryParam": "split", "switchesView": [".am-lanes", ".am-comm"] }, "source": "spec" },
        { "name": "보이기 토글", "selector": ".am-toggles [aria-label=보이기] button.chip", "kind": "inplace", "expect": { "ariaPressedToggles": true, "queryParam": "show" }, "source": "spec" },
        { "name": "드문 선 숨김 토글", "hash": "#/architecture?split=code", "selector": ".am-toggles button.am-thin", "kind": "inplace", "expect": { "ariaPressedToggles": true, "defaultOff": true, "chipText": "건수 N 미만 M 숨김" }, "source": "spec", "optional": true, "when": "communities >= 1" },
        { "name": "길 패널 기능 목록", "selector": "button.am-flowpick", "kind": "inplace", "expect": { "setsFlow": true, "hashPattern": "#/architecture/sys/<flow>" }, "source": "spec", "optional": true, "when": "flows >= 1" },
        { "name": "영향 패널 「이웃 펼치기」", "hash": "#/architecture/<node>", "selector": "button.am-expand", "kind": "inplace", "expect": { "ariaPressedToggles": true, "growsList": ".am-panel .am-list" }, "source": "spec", "optional": true, "when": "modules >= 1" },
        { "name": "영향 패널 「이 부품 안으로」", "hash": "#/architecture/part%3A<part>", "selector": "button.am-into", "kind": "inplace", "expect": { "setsFocus": "group:<lane>", "hashPattern": "#/architecture/group%3A<lane>" }, "source": "spec", "optional": true },
        { "name": "영향 패널 이웃 링크", "hash": "#/architecture/community%3A<community>", "selector": ".am-names button.am-link", "kind": "inplace", "expect": { "setsFocus": "<node>", "hashPattern": "#/architecture/<node>" }, "source": "spec", "optional": true, "when": "communities >= 1" }
      ]
    },
    "roadmap": {
      "hash": "#/roadmap",
      "targets": [
        { "name": "로드맵 상단 바 내비", "selector": ".nav a", "kind": "route", "expect": { "hrefs": ["#/overview", "#/journeys", "#/architecture", "#/roadmap", "#/tasks", "#/more"], "ariaCurrent": "#/roadmap" }, "source": "spec" },
        { "name": "로드맵 호스트 알약", "selector": "a.pill[target=_blank]", "kind": "external", "expect": { "hostFrom": "project.host", "rel": "noopener noreferrer" }, "source": "spec", "optional": true },
        { "name": "로드맵 상태 필터 칩", "selector": ".rm-filter button.chip", "kind": "inplace", "expect": { "ariaPressed": true }, "source": "spec" },
        { "name": "트리 잠긴 항목 흐리게", "selector": "button.rt-lockdim", "kind": "inplace", "expect": { "ariaPressedToggles": true }, "source": "spec" },
        { "name": "트리 노드", "selector": "a.rt-node[href^='#/roadmap/']", "kind": "route", "expect": { "pattern": "#/roadmap/<item>" }, "source": "spec" },
        { "name": "카드 선행·후속 링크", "selector": ".rm-deps a", "kind": "route", "expect": { "pattern": "#/roadmap/<item>" }, "source": "spec", "optional": true },
        { "name": "카드 함께 가리키는 항목 링크", "selector": ".rm-also a", "kind": "route", "expect": { "pattern": "#/roadmap/<item>" }, "source": "spec", "optional": true },
        { "name": "카드 연결 단계 칩", "selector": "a.rm-step", "kind": "route", "expect": { "pattern": "#/journeys/<journey>/<step>" }, "source": "spec", "optional": true },
        { "name": "카드 추적 작업", "selector": ".rm-kv a[href^='#/tasks/']", "kind": "route", "expect": { "pattern": "#/tasks/<task>" }, "source": "spec", "optional": true },
        { "name": "마일스톤 묶음 머리", "selector": ".rm-ms > summary", "kind": "inplace", "expect": { "togglesDetails": true }, "source": "spec", "optional": true, "when": "milestones >= 1" }
      ]
    }
  },
  "clickBudget": ["g.jrow", "a.open", ".scene", ".detail .node"],
  "keyboard": [
    { "step": "Tab으로 g.jrow 도달 후 Enter", "expect": "선택 동기" },
    { "step": "a.open에서 Enter", "expect": "#/journeys/<id>" },
    { "step": ".ticker .pause에서 Space", "expect": "aria-pressed 전환" },
    { "step": "캡처 썸네일에서 Space", "expect": "회전 정지" },
    { "step": "초점 요소", "expect": ":focus-visible 고리(outline 2px)" }
  ]
}
